@model IEnumerable<MiPulperiaBarrio.Models.Entidades.VwPulProductosInventario>

@{
    ViewData["Title"] = "Consulta de inventario";
    int? sucursalSeleccionada = ViewBag.SucursalId;
}

<h2 class="mb-3">Consulta de inventario por sucursal</h2>

<p class="text-muted">
    Consulte los productos, existencias disponibles y cantidades reservadas
    en las diferentes sucursales de Mi Pulpería de Barrio.
</p>

<form asp-action="Inventario" method="get" class="row g-3 mb-4">

    <div class="col-md-5">
        <label class="form-label">Producto</label>
        <input type="text" name="buscar" value="@ViewBag.Buscar"
               class="form-control"
               placeholder="Nombre, código o categoría" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Sucursal</label>
        <select name="sucursalId" class="form-select">
            <option value="">Todas las sucursales</option>
            @foreach (var sucursal in ViewBag.Sucursales)
            {
                if (sucursalSeleccionada == (int)sucursal.Id)
                {
                    <option value="@sucursal.Id" selected>
                        @sucursal.Nombre
                    </option>
                }
                else
                {
                    <option value="@sucursal.Id">
                        @sucursal.Nombre
                    </option>
                }
            }
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button type="submit" class="btn btn-success">Buscar</button>
        <a asp-action="Inventario" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Sucursal</th>
                <th>Provincia</th>
                <th>Precio</th>
                <th>Disponible</th>
                <th>Reservado</th>
                <th>Existencia mínima</th>
                <th>Atributos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Producto</td>
                    <td>@item.Categoria</td>
                    <td>@item.Sucursal</td>
                    <td>@item.Provincia</td>
                    <td>₡@((item.Precio ?? 0).ToString("N2"))</td>
                    <td>
                        <span class="badge bg-success">
                            @(item.CantidadDisponible ?? 0)
                        </span>
                    </td>
                    <td>
                        <span class="badge bg-warning text-dark">
                            @(item.CantidadReservada ?? 0)
                        </span>
                    </td>
                    <td>@(item.ExistenciaMinima ?? 0)</td>
                    <td>
                        <details>
                            <summary>Ver JSON</summary>
                            <pre class="small mt-2">@item.Atributos</pre>
                        </details>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron productos para los filtros indicados.
    </div>
}
else
{
    <p class="text-muted">
        Total de registros encontrados: @Model.Count()
    </p>
}
