@model MiPulperiaBarrio.Models.Formularios.ProductoFormulario

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Categoria" class="form-label"></label>
        <input asp-for="Categoria" class="form-control" />
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" type="number" step="0.01"
               min="0.01" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="MaximoReserva" class="form-label"></label>
        <input asp-for="MaximoReserva" type="number" min="1"
               class="form-control" />
        <span asp-validation-for="MaximoReserva" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="HorasReserva" class="form-label"></label>
        <input asp-for="HorasReserva" type="number" min="1"
               class="form-control" />
        <span asp-validation-for="HorasReserva" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ExistenciaMinima" class="form-label"></label>
        <input asp-for="ExistenciaMinima" type="number" min="0"
               class="form-control" />
        <span asp-validation-for="ExistenciaMinima" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Atributos" class="form-label"></label>
        <textarea asp-for="Atributos" rows="7"
                  class="form-control font-monospace"></textarea>
        <span asp-validation-for="Atributos" class="text-danger"></span>

        <div class="form-text">
            Ingrese un objeto JSON con las características del producto.
            Puede utilizar atributos diferentes para cada producto.
        </div>

        <div class="mt-2">
            <small>Ejemplo de atributos:</small>
            <pre class="bg-light border rounded p-2 mt-1">{
  "marca": "Dos Pinos",
  "contenido": "1 litro",
  "presentacion": "Caja"
}</pre>
        </div>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label">
                Producto activo
            </label>
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</div>
