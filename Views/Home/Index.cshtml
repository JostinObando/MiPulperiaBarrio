@{
    ViewData["Title"] = "Inicio";
}

<section class="p-4 p-md-5 rounded-3 text-white mb-4"
         style="background-color: #206c4a;">
    <h1 class="fw-bold">Bienvenido a Mi Pulpería de Barrio</h1>
    <p class="lead mb-0">
        Sistema de administración de sucursales, clientes e inventario.
    </p>
</section>

<h3 class="mb-3">Módulos del sistema</h3>

<div class="row g-4">

    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="card-title">Sucursales</h4>
                <p class="card-text text-muted">
                    Consultar, registrar, editar, activar y desactivar
                    las sucursales de la pulpería.
                </p>
                <a asp-controller="Sucursales" asp-action="Index"
                   class="btn btn-success">
                    Administrar sucursales
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="card-title">Clientes</h4>
                <p class="card-text text-muted">
                    Consultar, registrar, buscar, editar y gestionar
                    el estado de los clientes.
                </p>
                <a asp-controller="Clientes" asp-action="Index"
                   class="btn btn-success">
                    Administrar clientes
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="card-title">Productos</h4>
                <p class="card-text text-muted">
                    Catálogo de productos con atributos variables
                    almacenados en PostgreSQL mediante JSONB.
                </p>
                <span class="badge bg-secondary">
                    Próximamente
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="card-title">Reservas e inventario</h4>
                <p class="card-text text-muted">
                    Control de existencias, ingresos de inventario,
                    reservas y compras.
                </p>
                <span class="badge bg-secondary">
                    Segunda entrega
                </span>
            </div>
        </div>
    </div>

</div>

<div class="alert alert-light border mt-4">
    <strong>Tecnologías:</strong>
    ASP.NET Core MVC, C#, Entity Framework Core,
    PostgreSQL en Azure, Bootstrap y jQuery.
</div>
